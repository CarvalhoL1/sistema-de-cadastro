<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="250" prefWidth="400" spacing="12" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.TelaFrase">
    <children>
        <Button mnemonicParsing="false" onAction="#voltarPainel" text="Voltar para o login" />
        <Label prefHeight="18.0" prefWidth="219.0" text="Nova frase:" />
        <TextField fx:id="fraseCampo" maxWidth="220.0" minWidth="-Infinity" prefHeight="8.0" prefWidth="200.0" promptText="digite a frase aqui" />
        <Button mnemonicParsing="false" onAction="#mudarFrase" text="Atualizar" />
    </children>

</VBox>
