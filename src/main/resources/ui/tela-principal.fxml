<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="250" prefWidth="400" spacing="12" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.TelaPrincipal">
    <children>
        <Button mnemonicParsing="false" onAction="#abrirLogin" text="Logout" />
        <Label fx:id="mensagem" prefHeight="18.0" prefWidth="221.0" text="" />
      <Button mnemonicParsing="false" text="Buscar Usuario" onAction="#buscar"/>
      <Button mnemonicParsing="false" text="Editar nome" onAction="#nome"/>
      <Button mnemonicParsing="false" text="Editar senha" onAction="#senha"/>
      <Button mnemonicParsing="false" text="Editar Frase" onAction="#frase"/>
      <Button mnemonicParsing="false" text="Apagar conta"/>
    </children>

</VBox>
